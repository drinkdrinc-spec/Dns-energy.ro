# Copy this file to .env and replace every placeholder with real values.
# Do not commit .env or real secrets to GitHub.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dns_energy
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: required for Emergent integration-backed storage and AI features.
EMERGENT_LLM_KEY=
# Optional integration proxy base URL; defaults to https://integrations.emergentagent.com
INTEGRATION_PROXY_URL=
