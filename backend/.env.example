# Copy this file to .env and replace every placeholder with real values.
# Do not commit .env or real secrets to GitHub.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=dns_energy
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# AI provider: direct OpenAI API (requires a separately billed API key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Legacy Emergent keys remain optional only while legacy providers are selected.
EMERGENT_LLM_KEY=
# Optional integration proxy base URL; defaults to https://integrations.emergentagent.com
INTEGRATION_PROXY_URL=

# Optional Cloudflare R2 storage. Set OBJECT_STORAGE_BACKEND=r2 only after bucket migration and verification.
OBJECT_STORAGE_BACKEND=emergent
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dns-energy-files
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# Email provider: choose smtp to remove the Emergent email dependency.
EMAIL_PROVIDER=emergent
EMAIL_FROM_NAME=DNS Energy
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
