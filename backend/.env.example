# DNS Energy independent deployment — no Emergent dependencies
MONGO_URL=
DB_NAME=dns_energy
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Direct OpenAI API (billed separately from ChatGPT subscription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Cloudflare R2 object storage
OBJECT_STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dns-energy-files
R2_ENDPOINT_URL=

# SMTP email delivery
EMAIL_FROM_NAME=DNS Energy
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
